{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "npm",
    "github-actions",
    "custom.regex"
  ],
  "branchPrefix": "chore/renovate-",
  "semanticCommits": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/release-please\\.yml$/"
      ],
      "matchStrings": [
        "MCP_PUBLISHER_VERSION: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "modelcontextprotocol/registry",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "semanticCommitType": "chore",
      "groupName": "mcp-publisher"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": [
        "npm",
        "github-actions",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": [
        "npm",
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "weekly updates"
    }
  ],
  "timezone": "America/Mexico_City",
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 3,
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": true
}
